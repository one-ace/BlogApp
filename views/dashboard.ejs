<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title><%= user.fullName || 'User' %>'s Studio — Blog App</title>
</head>
<body class="bg-light">
  <header>
    <nav class="navbar navbar-expand-lg navbar-editorial sticky-top" aria-label="Dashboard Navigation">
      <div class="container py-1">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
          <span>Blog App</span>
        </a>
        <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#dashboardNav" aria-controls="dashboardNav" aria-expanded="false" aria-label="Toggle navigation">
          <i class="bi bi-list fs-3 text-dark"></i>
        </button>
        <div class="collapse navbar-collapse" id="dashboardNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
            <li class="nav-item">
              <a class="nav-link text-dark fw-semibold" href="/user/dashboard">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/">
                <i class="bi bi-house me-1"></i> Home
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/#explore">
                <i class="bi bi-compass me-1"></i> Explore
              </a>
            </li>
          </ul>
          <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
            <a href="/blog/new" class="btn btn-editorial-primary btn-sm px-3 d-flex align-items-center gap-2">
              <i class="bi bi-pencil-square"></i>
              <span>New Story</span>
            </a>
            <div class="dropdown">
              <a class="d-flex align-items-center gap-2 text-decoration-none py-1 px-2 rounded-3 border bg-white shadow-sm" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                <img src="<%= user.profileImageURL || '/images/male-face.jpg' %>" alt="Avatar" width="32" height="32" class="rounded-circle object-fit-cover border">
                <span class="small fw-semibold text-dark"><%= user.fullName || user.email %></span>
                <i class="bi bi-chevron-down small text-muted" style="font-size:0.7rem;"></i>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm border mt-2">
                <li>
                  <div class="dropdown-header text-truncate" style="max-width: 220px;">
                    <strong class="d-block text-dark"><%= user.fullName || 'Writer' %></strong>
                    <small class="text-muted"><%= user.email %></small>
                  </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item d-flex align-items-center gap-2" href="/blog/new"><i class="bi bi-pencil-square"></i> New Story</a></li>
                <li><a class="dropdown-item d-flex align-items-center gap-2" href="/user/profile/<%= user._id %>"><i class="bi bi-person"></i> Public Profile</a></li>
                <li><a class="dropdown-item d-flex align-items-center gap-2" href="/user/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="/user/logout"><i class="bi bi-box-arrow-right"></i> Log Out</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </header>
  <main class="py-5">
    <div class="container">
      <% if (typeof updated !== 'undefined' && updated) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i>
          Your author profile details have been successfully updated.
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      <div class="editorial-card p-4 p-md-5 mb-4 bg-white">
        <div class="row align-items-center g-4">
          <div class="col-12 col-md-auto text-center text-md-start">
            <img src="<%= user.profileImageURL || '/images/male-face.jpg' %>" alt="Author avatar" width="80" height="80" class="rounded-circle object-fit-cover border shadow-sm">
          </div>
          <div class="col-12 col-md text-center text-md-start">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
              <span class="badge bg-dark text-white text-uppercase small" style="letter-spacing: 0.05em;"><%= user.role || 'Writer' %></span>
              <span class="badge bg-light text-muted border small"><%= user.email %></span>
            </div>
            <h1 class="h3 font-serif fw-bold text-dark mb-1">
              Welcome to your studio, <%= user.fullName || user.email %>
            </h1>
            <p class="text-secondary small mb-0">
              <%= user.bio || 'Manage your publications, draft new articles, and observe how your stories reach readers.' %>
            </p>
          </div>
          <div class="col-12 col-md-auto text-center text-md-end d-flex flex-wrap justify-content-center gap-2">
            <a href="/user/profile/<%= user._id %>" class="btn btn-editorial-outline px-3 py-2">
              <i class="bi bi-eye me-1"></i> Public Profile
            </a>
            <a href="/blog/new" class="btn btn-editorial-primary px-4 py-2">
              <i class="bi bi-plus-lg me-1"></i> Write a Story
            </a>
          </div>
        </div>
      </div>
      <div class="row g-4 mb-4">
        <div class="col-12 col-sm-4">
          <div class="editorial-card p-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Published</span>
              <div class="feature-icon-wrapper" style="width: 36px; height: 36px; font-size: 1rem;">
                <i class="bi bi-file-earmark-text"></i>
              </div>
            </div>
            <div class="h2 fw-bold text-dark mb-1"><%= (publishedStories && publishedStories.length) || 0 %></div>
            <span class="text-muted small">Live public stories</span>
          </div>
        </div>
        <div class="col-12 col-sm-4">
          <div class="editorial-card p-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Drafts</span>
              <div class="feature-icon-wrapper" style="width: 36px; height: 36px; font-size: 1rem;">
                <i class="bi bi-file-earmark-diff"></i>
              </div>
            </div>
            <div class="h2 fw-bold text-dark mb-1"><%= (drafts && drafts.length) || 0 %></div>
            <span class="text-muted small">Works in progress</span>
          </div>
        </div>
        <div class="col-12 col-sm-4">
          <div class="editorial-card p-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Subscribers</span>
              <div class="feature-icon-wrapper" style="width: 36px; height: 36px; font-size: 1rem;">
                <i class="bi bi-people"></i>
              </div>
            </div>
            <div class="h2 fw-bold text-dark mb-1">0</div>
            <span class="text-muted small">Dedicated readers</span>
          </div>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <div class="editorial-card bg-white p-4 p-md-5">
            <%
              let currentTab = locals.activeTab || 'stories';
              if (!locals.activeTab && drafts && drafts.length > 0 && (!publishedStories || publishedStories.length === 0)) {
                currentTab = 'drafts';
              }
            %>
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
              <ul class="nav nav-pills gap-2" id="studioTabs" role="tablist">
                <li class="nav-item" role="presentation">
                  <button class="nav-link <%= currentTab === 'stories' ? 'active' : '' %> btn-sm px-3 rounded-3" id="stories-tab" data-bs-toggle="pill" data-bs-target="#stories-content" type="button" role="tab" aria-controls="stories-content" aria-selected="<%= currentTab === 'stories' %>">
                    Published (<%= (publishedStories && publishedStories.length) || 0 %>)
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link <%= currentTab === 'drafts' ? 'active' : '' %> btn-sm px-3 rounded-3" id="drafts-tab" data-bs-toggle="pill" data-bs-target="#drafts-content" type="button" role="tab" aria-controls="drafts-content" aria-selected="<%= currentTab === 'drafts' %>">
                    Drafts (<%= (drafts && drafts.length) || 0 %>)
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link <%= currentTab === 'profile' ? 'active' : '' %> btn-sm px-3 rounded-3" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile-content" type="button" role="tab" aria-controls="profile-content" aria-selected="<%= currentTab === 'profile' %>">
                    <i class="bi bi-person-gear me-1"></i> Profile Settings
                  </button>
                </li>
              </ul>
              <a href="/blog/new" class="btn btn-editorial-outline btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-sm-inline">New Draft</span>
              </a>
            </div>
            <div class="tab-content" id="studioTabsContent">
              <div class="tab-pane fade <%= currentTab === 'stories' ? 'show active' : '' %>" id="stories-content" role="tabpanel" aria-labelledby="stories-tab">
                <% if (publishedStories && publishedStories.length > 0) { %>
                  <div class="d-flex flex-column gap-3">
                    <% publishedStories.forEach(story => { %>
                      <div class="p-3 p-md-4 rounded-3 border bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                          <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="editorial-tag"><%= story.category || 'General' %></span>
                            <span class="text-muted small">·</span>
                            <span class="text-muted small">
                              Published on <%= new Date(story.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </span>
                          </div>
                          <h3 class="h6 font-serif fw-bold text-dark mb-1">
                            <a href="/blog/<%= story._id %>" class="text-dark text-decoration-none"><%= story.title %></a>
                          </h3>
                          <% const words = story.body ? story.body.trim().split(/\s+/).length : 0; %>
                          <span class="text-muted small">
                            <%= words %> words · <%= Math.max(1, Math.ceil(words / 200)) %> min read
                            <% if (story.likes && story.likes.length) { %>
                              · <i class="bi bi-heart-fill text-danger"></i> <%= story.likes.length %>
                            <% } %>
                          </span>
                        </div>
                        <div class="d-flex align-items-center gap-2 align-self-start align-self-md-center">
                          <a href="/blog/<%= story._id %>" class="btn btn-sm btn-editorial-outline" title="View Story">
                            <i class="bi bi-eye"></i> View
                          </a>
                          <a href="/blog/edit/<%= story._id %>" class="btn btn-sm btn-editorial-outline" title="Edit Story">
                            <i class="bi bi-pencil"></i> Edit
                          </a>
                          <form action="/blog/delete/<%= story._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this story?');" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Story">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="text-center py-5">
                    <div class="feature-icon-wrapper mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                      <i class="bi bi-journal-text text-secondary"></i>
                    </div>
                    <h3 class="h5 font-serif fw-bold text-dark mb-2">You haven't published any stories yet</h3>
                    <p class="text-secondary small mx-auto mb-4" style="max-width: 420px; line-height: 1.6;">
                      Your ideas deserve a place to be read. When you publish an article, it will appear here alongside readership statistics.
                    </p>
                    <a href="/blog/new" class="btn btn-editorial-primary px-4">
                      <i class="bi bi-pencil-square me-1"></i> Write Your First Story
                    </a>
                  </div>
                <% } %>
              </div>
              <div class="tab-pane fade <%= currentTab === 'drafts' ? 'show active' : '' %>" id="drafts-content" role="tabpanel" aria-labelledby="drafts-tab">
                <% if (drafts && drafts.length > 0) { %>
                  <div class="d-flex flex-column gap-3">
                    <% drafts.forEach(draft => { %>
                      <div class="p-3 p-md-4 rounded-3 border bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                          <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-secondary-subtle text-secondary small"><%= draft.category || 'General' %></span>
                            <span class="text-muted small">·</span>
                            <span class="text-muted small">
                              Edited on <%= new Date(draft.updatedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </span>
                          </div>
                          <h3 class="h6 font-serif fw-bold text-dark mb-1">
                            <a href="/blog/edit/<%= draft._id %>" class="text-dark text-decoration-none"><%= draft.title || 'Untitled Draft' %></a>
                          </h3>
                          <% const draftWords = draft.body ? draft.body.trim().split(/\s+/).length : 0; %>
                          <span class="text-muted small"><%= draftWords %> words written</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 align-self-start align-self-md-center">
                          <a href="/blog/edit/<%= draft._id %>" class="btn btn-sm btn-editorial-primary">
                            <i class="bi bi-pencil-square me-1"></i> Edit Draft
                          </a>
                          <form action="/blog/delete/<%= draft._id %>" method="POST" onsubmit="return confirm('Delete this draft?');" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Draft">
                              <i class="bi bi-trash"></i>
                            </button>
                          </form>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="text-center py-5">
                    <div class="feature-icon-wrapper mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                      <i class="bi bi-file-earmark-diff text-secondary"></i>
                    </div>
                    <h3 class="h5 font-serif fw-bold text-dark mb-2">No active drafts</h3>
                    <p class="text-secondary small mx-auto mb-4" style="max-width: 420px; line-height: 1.6;">
                      Have an idea brewing? Start a draft anytime. Everything is automatically saved to your private studio.
                    </p>
                    <a href="/blog/new" class="btn btn-editorial-primary px-4">
                      <i class="bi bi-plus-lg me-1"></i> Create a Draft
                    </a>
                  </div>
                <% } %>
              </div>
              <div class="tab-pane fade <%= currentTab === 'profile' ? 'show active' : '' %>" id="profile-content" role="tabpanel" aria-labelledby="profile-tab">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                  <div>
                    <h3 class="h6 font-serif fw-bold text-dark mb-0">Profile Information</h3>
                    <div class="text-muted extra-small">Control how you appear across articles and author listings.</div>
                  </div>
                  <a href="/user/edit-profile" class="btn btn-sm btn-editorial-outline">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Full Page Editor
                  </a>
                </div>
                <form action="/user/profile" method="POST" enctype="multipart/form-data">
                  <input type="hidden" name="redirect" value="dashboard">
                  <div class="row g-4 align-items-center mb-4">
                    <div class="col-auto">
                      <img src="<%= user.profileImageURL || '/images/male-face.jpg' %>" id="profilePreview" alt="Avatar preview" width="72" height="72" class="rounded-circle object-fit-cover border shadow-sm">
                    </div>
                    <div class="col">
                      <label for="profileImageInput" class="btn btn-sm btn-editorial-outline d-inline-flex align-items-center gap-2">
                        <i class="bi bi-camera"></i> Change Avatar Photo
                      </label>
                      <input type="file" name="profileImage" id="profileImageInput" class="d-none" accept="image/*">
                      <div class="text-muted small mt-1">Recommended: Square image, max 3MB (JPEG, PNG, WebP)</div>
                    </div>
                  </div>
                  <div class="mb-3">
                    <label for="fullName" class="form-label small fw-semibold text-muted">Full Name</label>
                    <input type="text" name="fullName" id="fullName" class="form-control" value="<%= user.fullName || '' %>" required>
                  </div>
                  <div class="mb-3">
                    <label for="email" class="form-label small fw-semibold text-muted">Email Address (account)</label>
                    <input type="email" class="form-control bg-light" value="<%= user.email || '' %>" disabled>
                    <div class="form-text">Email address cannot be changed directly.</div>
                  </div>
                  <div class="mb-3">
                    <label for="bio" class="form-label small fw-semibold text-muted">Author Bio (Short summary shown on your stories)</label>
                    <textarea name="bio" id="bio" class="form-control" rows="3" maxlength="300" placeholder="Share a few words about your background, interests, or what you write about..."><%= user.bio || '' %></textarea>
                    <div class="form-text">Maximum 300 characters.</div>
                  </div>
                  <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6">
                      <label for="location" class="form-label small fw-semibold text-muted">Location</label>
                      <input type="text" name="location" id="location" class="form-control" value="<%= user.location || '' %>" placeholder="e.g. London, UK">
                    </div>
                    <div class="col-12 col-sm-6">
                      <label for="website" class="form-label small fw-semibold text-muted">Website / Link</label>
                      <input type="url" name="website" id="website" class="form-control" value="<%= user.website || '' %>" placeholder="https://yoursite.com">
                    </div>
                  </div>
                  <button type="submit" class="btn btn-editorial-primary px-4">
                    Save Profile Changes
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="editorial-card bg-white p-4 mb-4">
            <h4 class="h6 fw-bold text-dark text-uppercase small mb-3" style="letter-spacing: 0.05em;">Author Card</h4>
            <div class="d-flex align-items-center gap-3 mb-3">
              <img src="<%= user.profileImageURL || '/images/male-face.jpg' %>" alt="Profile" width="48" height="48" class="rounded-circle object-fit-cover border">
              <div>
                <div class="fw-bold text-dark"><%= user.fullName || 'Writer' %></div>
                <div class="text-muted small"><%= user.email %></div>
              </div>
            </div>
            <% if (user.bio) { %>
              <p class="text-secondary small mb-3 fst-italic">"<%= user.bio %>"</p>
            <% } %>
            <div class="pt-3 border-top d-flex justify-content-between text-muted small">
              <span>Account Status:</span>
              <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
            </div>
            <div class="pt-2 d-flex justify-content-between text-muted small">
              <span>Public Page:</span>
              <a href="/user/profile/<%= user._id %>" class="fw-semibold text-dark text-decoration-none">View Profile <i class="bi bi-box-arrow-up-right small"></i></a>
            </div>
            <a href="/user/edit-profile" class="btn btn-editorial-outline btn-sm w-100 mt-3">
              <i class="bi bi-pencil me-1"></i> Edit Profile
            </a>
          </div>
          <div class="editorial-card bg-white p-4">
            <h4 class="h6 fw-bold text-dark text-uppercase small mb-3" style="letter-spacing: 0.05em;">Writing Inspiration</h4>
            <ul class="list-unstyled d-flex flex-column gap-3 mb-4 small text-secondary">
              <li class="d-flex align-items-start gap-2">
                <i class="bi bi-lightbulb text-warning mt-1"></i>
                <span><strong>Write for clarity:</strong> Cut unnecessary adverbs and allow your central argument to stand on its own.</span>
              </li>
              <li class="d-flex align-items-start gap-2">
                <i class="bi bi-lightbulb text-warning mt-1"></i>
                <span><strong>Pacing matters:</strong> Mix short, punchy sentences with thoughtful paragraphs for natural reading rhythm.</span>
              </li>
              <li class="d-flex align-items-start gap-2">
                <i class="bi bi-lightbulb text-warning mt-1"></i>
                <span><strong>Engage the community:</strong> Leave readers with a lingering question or open prompt at the end of your essay.</span>
              </li>
            </ul>
            <a href="/#explore" class="btn btn-editorial-outline w-100 text-center small">
              <i class="bi bi-compass me-1"></i> Explore Community Stories
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <footer class="footer-editorial py-4 mt-5">
    <div class="container text-center text-muted small">
      <p class="mb-0">&copy; 2026 Blog App. Logged in as <%= user.email %></p>
    </div>
  </footer>
  <script>
    // Live client-side avatar image preview
    const avatarInput = document.getElementById('profileImageInput');
    const avatarPreview = document.getElementById('profilePreview');
    if (avatarInput && avatarPreview) {
      avatarInput.addEventListener('change', function () {
        if (this.files && this.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            avatarPreview.src = e.target.result;
          };
          reader.readAsDataURL(this.files[0]);
        }
      });
    }
  </script>
  <%- include('./partials/scripts') %>
</body>
</html>
