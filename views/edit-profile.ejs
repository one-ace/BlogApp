<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Edit Profile — Blog App</title>
  <meta name="description" content="Update your author profile, avatar, bio, and social links on Blog App.">
</head>
<body class="bg-body-warm">
  <%- include('./partials/nav') %>
  <main class="py-5">
    <div class="container" style="max-width: 820px;">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <a href="/user/dashboard" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
              <i class="bi bi-arrow-left"></i> Studio Dashboard
            </a>
            <span class="text-muted small">/</span>
            <span class="text-muted small">Profile</span>
          </div>
          <h1 class="h2 font-serif fw-bold text-dark mb-0">Edit Author Profile</h1>
        </div>
        <div>
          <a href="/user/profile/<%= user._id %>" class="btn btn-editorial-outline btn-sm d-inline-flex align-items-center gap-1">
            <i class="bi bi-person-badge"></i> View Public Profile
          </a>
        </div>
      </div>
      <% if (locals.updated) { %>
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm mb-4" role="alert">
          <i class="bi bi-check-circle-fill fs-5 text-success"></i>
          <div>
            <strong>Profile updated successfully!</strong> Your changes are now live on your stories and public profile.
          </div>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      <% if (locals.error === 'invalid-url') { %>
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm mb-4" role="alert">
          <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
          <div>
            <strong>Invalid website URL.</strong> Please enter a full URL starting with <code>http://</code> or <code>https://</code>.
          </div>
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      <form action="/user/profile" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="redirect" value="edit">
        <div class="row g-4">
          <div class="col-12 col-md-4">
            <div class="editorial-card p-4 bg-white text-center h-100 d-flex flex-column justify-content-between">
              <div>
                <h2 class="h6 fw-bold text-dark text-uppercase small mb-3" style="letter-spacing: 0.05em;">Profile Photo</h2>
                <div class="position-relative d-inline-block mb-3">
                  <img src="<%= user.profileImageURL || '/images/male-face.jpg' %>" id="avatarPreview" alt="Avatar preview" width="110" height="110" class="rounded-circle object-fit-cover border shadow-sm">
                </div>
                <div class="mb-3">
                  <label for="profilePhotoInput" class="btn btn-sm btn-editorial-outline w-100 d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-camera"></i> Upload New Photo
                  </label>
                  <input type="file" name="profileImage" id="profilePhotoInput" class="d-none" accept="image/*" onchange="previewAvatar(event)">
                </div>
                <p class="text-secondary extra-small mb-0" style="font-size: 0.75rem;">
                  JPG, PNG, or WebP.<br>Square aspect ratio recommended (Max 3MB).
                </p>
              </div>
              <div class="pt-4 border-top mt-4 text-start">
                <div class="d-flex justify-content-between align-items-center small text-muted mb-2">
                  <span>Role:</span>
                  <span class="badge bg-dark text-white"><%= user.role || 'USER' %></span>
                </div>
                <div class="d-flex justify-content-between align-items-center small text-muted">
                  <span>Joined:</span>
                  <span><%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></span>
                </div>
              </div>
            </div>
          </div>
          <div class="col-12 col-md-8">
            <div class="editorial-card p-4 p-md-5 bg-white">
              <div class="mb-4">
                <label for="fullName" class="form-label small fw-semibold text-dark">
                  Full Name <span class="text-danger">*</span>
                </label>
                <input type="text" name="fullName" id="fullName" class="form-control form-control-lg fs-6" value="<%= user.fullName || '' %>" placeholder="e.g. Maya Chen" required>
                <div class="form-text small">This is the author byline displayed across all your articles.</div>
              </div>
              <div class="mb-4">
                <label for="email" class="form-label small fw-semibold text-muted">
                  Email Address
                </label>
                <input type="email" class="form-control bg-light text-secondary" id="email" value="<%= user.email || '' %>" disabled>
                <div class="form-text extra-small">Your account email address is used for signing in.</div>
              </div>
              <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label for="bio" class="form-label small fw-semibold text-dark mb-0">
                    Author Bio
                  </label>
                  <span class="text-muted extra-small" id="bioCounter">0 / 300</span>
                </div>
                <textarea name="bio" id="bio" class="form-control" rows="3" maxlength="300" placeholder="A brief sentence or two summarizing who you are, what you explore, or what you write about..." oninput="updateBioCount()"><%= user.bio || '' %></textarea>
                <div class="form-text small">Appears on your public profile and below your published stories.</div>
              </div>
              <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6">
                  <label for="location" class="form-label small fw-semibold text-dark">
                    <i class="bi bi-geo-alt me-1 text-muted"></i> Location
                  </label>
                  <input type="text" name="location" id="location" class="form-control" value="<%= user.location || '' %>" placeholder="e.g. San Francisco, CA">
                </div>
                <div class="col-12 col-sm-6">
                  <label for="website" class="form-label small fw-semibold text-dark">
                    <i class="bi bi-link-45deg me-1 text-muted"></i> Website / Portfolio
                  </label>
                  <input type="url" name="website" id="website" class="form-control" value="<%= user.website || '' %>" placeholder="https://yoursite.com">
                </div>
              </div>
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
                <a href="/user/profile/<%= user._id %>" class="btn btn-editorial-outline">
                  Cancel
                </a>
                <button type="submit" class="btn btn-editorial-primary px-4 py-2">
                  <i class="bi bi-check2 me-1"></i> Save Changes
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
  </main>
  <%- include('./partials/scripts') %>
  <script>
    // Live Avatar Preview
    function previewAvatar(event) {
      const input = event.target;
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('avatarPreview').src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
      }
    }
    // Bio Character Counter
    function updateBioCount() {
      const bio = document.getElementById('bio');
      const counter = document.getElementById('bioCounter');
      if (bio && counter) {
        counter.textContent = `${bio.value.length} / 300`;
      }
    }
    document.addEventListener('DOMContentLoaded', updateBioCount);
  </script>
</body>
</html>
