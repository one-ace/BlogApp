<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Forgot Password — Blog App</title>
  <style>
    body {
      min-height: 100vh;
      background-color: var(--editorial-bg);
    }
    .auth-wrapper {
      min-height: calc(100vh - 5rem);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem;
    }
    .auth-card {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      border: 1px solid var(--editorial-border);
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      padding: 2.5rem 2.25rem;
    }
    .auth-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .auth-header h1 {
      font-family: var(--font-serif);
      font-size: 2rem;
      font-weight: 600;
      color: var(--editorial-text);
      margin-bottom: 0.35rem;
      letter-spacing: -0.02em;
    }
    .auth-header p {
      color: var(--editorial-text-muted);
      font-size: 0.95rem;
      margin-bottom: 0;
      line-height: 1.5;
    }
    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--editorial-text);
    }
    .form-control {
      border-radius: 8px;
      border: 1px solid #d4d4d8;
      padding: 0.65rem 0.85rem;
      font-size: 0.95rem;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-control:focus {
      border-color: var(--editorial-accent);
      box-shadow: 0 0 0 3px rgba(24, 24, 27, 0.1);
    }
    .btn-auth-primary {
      background: var(--editorial-accent);
      border: 1px solid var(--editorial-accent);
      border-radius: 8px;
      padding: 0.7rem 1rem;
      font-weight: 600;
      font-size: 0.95rem;
      width: 100%;
      color: #ffffff;
      transition: background-color 0.15s ease;
    }
    .btn-auth-primary:hover {
      background: #27272a;
      border-color: #27272a;
      color: #ffffff;
    }
    .auth-footer {
      text-align: center;
      margin-top: 1.75rem;
      font-size: 0.9rem;
      color: var(--editorial-text-muted);
    }
    .auth-footer a {
      color: var(--editorial-accent);
      font-weight: 600;
      text-decoration: none;
    }
    .auth-footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <%- include('./partials/nav') %>
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3 text-secondary" style="width: 52px; height: 52px; font-size: 1.4rem;">
          <i class="bi bi-shield-lock"></i>
        </div>
        <h1>Reset your password</h1>
        <p>Enter the email address associated with your account, and we'll send you a link to reset your password.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-circle-fill me-1"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <h6 class="alert-heading fw-bold mb-1"><i class="bi bi-envelope-check-fill me-1"></i> Check your inbox</h6>
          <p class="small mb-0">If an account exists for <strong><%= email %></strong>, we've sent instructions to reset your password. The link expires in 1 hour.</p>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <% if (typeof simulatedResetUrl !== 'undefined' && simulatedResetUrl) { %>
          <div class="p-3 mb-3 bg-light border rounded-3 small">
            <div class="fw-bold text-dark mb-1"><i class="bi bi-terminal-fill me-1"></i> Development Reset Link:</div>
            <p class="text-muted small mb-2">Since SMTP is in local mode, you can test directly using this link:</p>
            <a href="<%= simulatedResetUrl %>" class="btn btn-sm btn-dark text-white text-decoration-none">
              Reset Password Now &rarr;
            </a>
          </div>
        <% } %>
      <% } %>

      <form action="/user/forgot-password" method="POST">
        <div class="mb-4">
          <label for="email" class="form-label">Email address</label>
          <input type="email" name="email" class="form-control" id="email" placeholder="name@example.com" value="<%= typeof email !== 'undefined' ? email : '' %>" required autofocus>
        </div>
        <button type="submit" class="btn-auth-primary">Send Reset Link</button>
      </form>

      <div class="auth-footer">
        <a href="/user/signin" class="d-inline-flex align-items-center gap-1">
          <i class="bi bi-arrow-left"></i> Back to sign in
        </a>
      </div>
    </div>
  </div>
  <%- include('./partials/scripts') %>
</body>
</html>
