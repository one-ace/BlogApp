<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title><%= author.fullName || 'Author' %> — Blog App Profile</title>
</head>
<body class="bg-light">
  <%- include('./partials/nav') %>
  <main class="py-5">
    <div class="container" style="max-width: 840px;">
      <div class="editorial-card p-4 p-md-5 mb-5 bg-white">
        <div class="row align-items-center g-4">
          <div class="col-12 col-md-auto text-center text-md-start">
            <img src="<%= author.profileImageURL || '/images/male-face.jpg' %>" alt="<%= author.fullName %>" width="96" height="96" class="rounded-circle object-fit-cover border shadow-sm">
          </div>
          <div class="col-12 col-md text-center text-md-start">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
              <span class="badge bg-dark text-white text-uppercase small" style="letter-spacing: 0.05em;"><%= author.role || 'Author' %></span>
              <span class="text-muted small">
                Member since <%= new Date(author.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
              </span>
            </div>
            <h1 class="h2 font-serif fw-bold text-dark mb-2"><%= author.fullName || 'Author' %></h1>
            <p class="text-secondary small mb-3" style="max-width: 540px; line-height: 1.6;">
              <%= author.bio || 'Sharing perspective, craft, and thoughtful stories on Blog App.' %>
            </p>
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-3 small text-muted">
              <span><strong><%= (articles && articles.length) || 0 %></strong> published <%= ((articles && articles.length) === 1) ? 'story' : 'stories' %></span>
              <% if (author.location) { %>
                <span>·</span>
                <span><i class="bi bi-geo-alt me-1"></i><%= author.location %></span>
              <% } %>
              <% if (author.website) { %>
                <span>·</span>
                <a href="<%= author.website %>" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-dark fw-semibold">
                  <i class="bi bi-link-45deg me-1"></i>Website
                </a>
              <% } %>
            </div>
          </div>
          <% if (locals.user && locals.user._id.toString() === author._id.toString()) { %>
            <div class="col-12 col-md-auto text-center text-md-end">
              <a href="/user/edit-profile" class="btn btn-editorial-outline btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Profile
              </a>
            </div>
          <% } %>
        </div>
      </div>
      <section>
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
          <h2 class="h5 font-serif fw-bold text-dark mb-0">Published Stories (<%= (articles && articles.length) || 0 %>)</h2>
        </div>
        <% if (articles && articles.length > 0) { %>
          <div class="d-flex flex-column gap-4">
            <% articles.forEach(story => { %>
              <article class="editorial-card p-4 bg-white">
                <div class="row g-3 align-items-center">
                  <% if (story.coverImageURL) { %>
                    <div class="col-12 col-sm-4 col-md-3">
                      <a href="/blog/<%= story._id %>">
                        <img src="<%= story.coverImageURL %>" alt="<%= story.title %>" class="w-100 rounded-3 object-fit-cover" style="height: 120px;">
                      </a>
                    </div>
                  <% } %>
                  <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <span class="editorial-tag"><%= story.category || 'General' %></span>
                      <span class="text-muted small">·</span>
                      <span class="text-muted small">
                        <%= new Date(story.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </span>
                    </div>
                    <h3 class="h5 font-serif fw-bold text-dark mb-2">
                      <a href="/blog/<%= story._id %>" class="text-dark text-decoration-none"><%= story.title %></a>
                    </h3>
                    <p class="text-secondary small mb-3 text-truncate" style="max-width: 580px;">
                      <%= story.body ? story.body.replace(/[#*`_>]/g, '').substring(0, 160) + '...' : '' %>
                    </p>
                    <div class="d-flex align-items-center justify-content-between">
                      <% const wordCount = story.body ? story.body.trim().split(/\s+/).length : 0; %>
                      <span class="text-muted small"><i class="bi bi-clock me-1"></i><%= Math.max(1, Math.ceil(wordCount / 200)) %> min read</span>
                      <a href="/blog/<%= story._id %>" class="btn btn-editorial-outline btn-sm">
                        Read Story <i class="bi bi-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <div class="editorial-card p-5 bg-white text-center text-muted">
            <i class="bi bi-journal-x fs-2 d-block mb-2 text-secondary"></i>
            <p class="mb-0">This author hasn't published any stories yet.</p>
          </div>
        <% } %>
      </section>
    </div>
  </main>
  <footer class="footer-editorial py-4 mt-5">
    <div class="container text-center text-muted small">
      <p class="mb-0">&copy; 2026 Blog App. All rights reserved.</p>
    </div>
  </footer>
  <%- include('./partials/scripts') %>
</body>
</html>
