<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
  <title>Reset Password — Blog App</title>
  <style>
    body {
      min-height: 100vh;
      background-color: var(--editorial-bg);
    }
    .auth-wrapper {
      min-height: calc(100vh - 5rem);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem;
    }
    .auth-card {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      border: 1px solid var(--editorial-border);
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      padding: 2.5rem 2.25rem;
    }
    .auth-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .auth-header h1 {
      font-family: var(--font-serif);
      font-size: 2rem;
      font-weight: 600;
      color: var(--editorial-text);
      margin-bottom: 0.35rem;
      letter-spacing: -0.02em;
    }
    .auth-header p {
      color: var(--editorial-text-muted);
      font-size: 0.95rem;
      margin-bottom: 0;
      line-height: 1.5;
    }
    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--editorial-text);
    }
    .form-control {
      border-radius: 8px;
      border: 1px solid #d4d4d8;
      padding: 0.65rem 0.85rem;
      font-size: 0.95rem;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .form-control:focus {
      border-color: var(--editorial-accent);
      box-shadow: 0 0 0 3px rgba(24, 24, 27, 0.1);
    }
    .password-field {
      position: relative;
    }
    .password-toggle {
      position: absolute;
      right: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: #71717a;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      padding: 0;
      letter-spacing: 0.05em;
    }
    .password-toggle:hover {
      color: var(--editorial-text);
    }
    .btn-auth-primary {
      background: var(--editorial-accent);
      border: 1px solid var(--editorial-accent);
      border-radius: 8px;
      padding: 0.7rem 1rem;
      font-weight: 600;
      font-size: 0.95rem;
      width: 100%;
      color: #ffffff;
      transition: background-color 0.15s ease;
    }
    .btn-auth-primary:hover {
      background: #27272a;
      border-color: #27272a;
      color: #ffffff;
    }
    .auth-footer {
      text-align: center;
      margin-top: 1.75rem;
      font-size: 0.9rem;
      color: var(--editorial-text-muted);
    }
    .auth-footer a {
      color: var(--editorial-accent);
      font-weight: 600;
      text-decoration: none;
    }
    .auth-footer a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <%- include('./partials/nav') %>
  <div class="auth-wrapper">
    <div class="auth-card">
      <% if (typeof token === 'undefined' || !token) { %>
        <div class="auth-header">
          <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle mb-3" style="width: 52px; height: 52px; font-size: 1.4rem;">
            <i class="bi bi-x-octagon"></i>
          </div>
          <h1>Link Expired or Invalid</h1>
          <p><%= typeof error !== 'undefined' && error ? error : 'This password reset link is invalid or has expired.' %></p>
        </div>
        <div class="d-flex flex-column gap-2">
          <a href="/user/forgot-password" class="btn btn-auth-primary text-center">Request a New Link</a>
          <a href="/user/signin" class="btn btn-editorial-outline text-center">Back to Sign In</a>
        </div>
      <% } else { %>
        <div class="auth-header">
          <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3 text-secondary" style="width: 52px; height: 52px; font-size: 1.4rem;">
            <i class="bi bi-key-fill"></i>
          </div>
          <h1>Set new password</h1>
          <p>Your new password must be at least 8 characters long.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle-fill me-1"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <form action="/user/reset-password/<%= token %>" method="POST">
          <div class="mb-3">
            <label for="password" class="form-label">New password</label>
            <div class="password-field">
              <input type="password" name="password" class="form-control" id="password" placeholder="At least 8 characters" minlength="8" required autofocus>
              <button type="button" class="password-toggle" id="togglePassword">SHOW</button>
            </div>
          </div>
          <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirm new password</label>
            <div class="password-field">
              <input type="password" name="confirmPassword" class="form-control" id="confirmPassword" placeholder="Confirm your new password" minlength="8" required>
              <button type="button" class="password-toggle" id="toggleConfirmPassword">SHOW</button>
            </div>
          </div>
          <button type="submit" class="btn-auth-primary">Update Password</button>
        </form>

        <div class="auth-footer">
          <a href="/user/signin" class="d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to sign in
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    function setupToggle(btnId, inputId) {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId);
      if (btn && input) {
        btn.addEventListener('click', () => {
          const isHidden = input.type === 'password';
          input.type = isHidden ? 'text' : 'password';
          btn.textContent = isHidden ? 'HIDE' : 'SHOW';
        });
      }
    }
    setupToggle('togglePassword', 'password');
    setupToggle('toggleConfirmPassword', 'confirmPassword');
  </script>
  <%- include('./partials/scripts') %>
</body>
</html>
